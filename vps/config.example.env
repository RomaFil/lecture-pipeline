# Змінні середовища конвеєра. Значення нижче — дефолти з run.sh;
# перевизначай лише те, що справді треба змінити.

# Корінь робочих тек (incoming, outgoing, archive, work, _needs-review, logs, bin)
LECTURES_HOME=/home/user/lectures

# Модель faster-whisper. large-v3 дає помітно кращу українську за medium,
# але потребує ~2.9 ГБ RAM. Якщо пам`яті мало — medium.
WHISPER_MODEL=large-v3
WHISPER_LANG=uk

# Модель класифікатора в Ollama. 7B помітно розумніша за 3B саме на темах:
# 3B правильно визначає дисципліну, але формулює теми на кшталт «ряди».
LECTURE_LLM=qwen2.5:7b-instruct-q4_K_M
OLLAMA_URL=http://127.0.0.1:11434

# 0 = вивантажувати модель одразу після відповіді. Потрібно, коли RAM ділиться
# з whisper. Для пакетних тестів зручно виставити 5m.
LECTURE_KEEP_ALIVE=0

# Скільки днів тримати відео на VPS після заливки, перш ніж видалити.
# Менше 2-3 днів ставити не варто: YouTube обробляє довгі відео небистро,
# а відхилення приходить уже після того, як файл «успішно» прийнято.
LECTURE_RETENTION_DAYS=7
